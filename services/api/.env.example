DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/textshop?schema=public"
PORT=3001
NODE_ENV="development"

# Storefront URL used by hosted payment providers for return redirects.
STOREFRONT_URL="http://localhost:3000"

# Payment provider selection.
# MANUAL_TEST is local-development only and is rejected in production.
# STRIPE enables hosted Stripe Checkout when credentials are present.
PAYMENT_PROVIDER="MANUAL_TEST"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Customer authentication
# Use a unique random value of at least 32 characters.
AUTH_JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Guest-order capability signing
# Must be different from AUTH_JWT_SECRET and at least 32 characters.
ORDER_ACCESS_SECRET="replace-with-another-unique-random-secret-at-least-32-characters"

# Email delivery for account security + transactional order updates
# CONSOLE logs verification/reset links and transactional email previews during local development only.
# SMTP is required for production email delivery.
EMAIL_DELIVERY_MODE="CONSOLE"
EMAIL_FROM="TextShop <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""


# Product media (Phase 044 local-storage adapter)
# Set this to an API URL reachable by every client that must render uploaded images.
MEDIA_PUBLIC_BASE_URL="http://localhost:3001"
# Optional absolute/relative storage directory. Defaults to services/api/storage/media.
MEDIA_LOCAL_ROOT=""
# Push notifications
# Keep CONSOLE during local development; switch to FCM after Firebase is configured.
PUSH_ENABLED=true
PUSH_DELIVERY_MODE=CONSOLE
FCM_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS is read by GoogleAuth/ADC at runtime when FCM
# delivery is enabled. Keep the service-account JSON outside Git.

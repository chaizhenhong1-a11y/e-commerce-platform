DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/textshop?schema=public"
PORT=3001
NODE_ENV="development"

# Storefront URL used by hosted payment providers for return redirects.
STOREFRONT_URL="http://localhost:3000"

# Payment provider selection.
# MANUAL_TEST is local-development only and is rejected in production.
# STRIPE enables hosted Stripe Checkout when credentials are present.
PAYMENT_PROVIDER="MANUAL_TEST"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Customer authentication
# Use a unique random value of at least 32 characters.
AUTH_JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Guest-order capability signing
# Must be different from AUTH_JWT_SECRET and at least 32 characters.
ORDER_ACCESS_SECRET="replace-with-another-unique-random-secret-at-least-32-characters"

# Account email delivery
# CONSOLE prints verification/reset URLs during local development only.
# SMTP is required for production account emails.
EMAIL_DELIVERY_MODE="CONSOLE"
EMAIL_FROM="TextShop <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""


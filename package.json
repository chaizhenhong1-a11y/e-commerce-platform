{
  "name": "elvane-workspace",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/storefront",
    "services/api"
  ],
  "scripts": {
    "dev:web": "npm --workspace @elvane/storefront run dev",
    "dev:api": "npm --workspace @elvane/api run start:dev",
    "build:web": "npm --workspace @elvane/storefront run build",
    "build:api": "npm --workspace @elvane/api run build",
    "lint:web": "npm --workspace @elvane/storefront run lint",
    "test:api": "npm --workspace @elvane/api run test",
    "verify:server": "npm run test:api && npm run build:api && npm run build:web",
    "verify:flutter": "cd apps/mobile && flutter analyze",
    "verify": "npm run verify:server && npm run verify:flutter"
  }
}
